# ─── Application ───────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_NAME=SEARCHRANK OS

# ─── Database ──────────────────────────────────────────────────
# Leave DATABASE_URL empty for local development: an embedded PGlite database
# is created at PGLITE_DATA_DIR. Set DATABASE_URL to a Neon Postgres connection
# string to run against Neon in production.
DATABASE_URL=
PGLITE_DATA_DIR=./.data/pglite
DATABASE_SSL=true

# ─── Security ──────────────────────────────────────────────────
# 32-byte key, base64 encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MASTER_ENCRYPTION_KEY=
SESSION_COOKIE_NAME=sr_session
SESSION_TTL_HOURS=168
# Allow new user registration after the first account exists.
ALLOW_SIGNUPS=false
# Required for the Vercel Cron endpoint (/api/cron/scheduler).
CRON_SECRET=

# ─── Bootstrap administrator (created by `pnpm db:seed`) ──────
SEED_ADMIN_EMAIL=admin@searchrank.local
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Platform Administrator

# ─── AI provider ───────────────────────────────────────────────
# openai-compatible | anthropic | none
AI_PROVIDER=none
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_MAX_TOKENS=4096

# ─── GitHub OAuth / API ────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/api/auth/callback/github

# ─── Vercel OAuth / API ────────────────────────────────────────
VERCEL_CLIENT_ID=
VERCEL_CLIENT_SECRET=
VERCEL_CALLBACK_URL=http://localhost:3000/api/auth/callback/vercel

# ─── Google Search Console ─────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/callback/google

# ─── Microsoft / Bing Webmaster ───────────────────────────────
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_CALLBACK_URL=http://localhost:3000/api/auth/callback/microsoft

# ─── IndexNow ──────────────────────────────────────────────────
INDEXNOW_KEY=
INDEXNOW_KEY_LOCATION=

# ─── Worker ────────────────────────────────────────────────────
WORKER_POLL_MS=2000
WORKER_CONCURRENCY=4
WORKER_ID=local-worker-1
