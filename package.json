    "worker:once": "tsx scripts/worker-once.ts",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.17",
    "@neondatabase/serverless": "1.2.1",
